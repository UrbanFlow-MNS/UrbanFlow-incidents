BRANCH_NAME=$(git rev-parse --abbrev-ref HEAD)

if ! echo "$BRANCH_NAME" | grep -Eq '^(feature|fix|refactor|test)/'; then
  echo "❌ Nom de branche invalide : '$BRANCH_NAME'"
  echo "➡️  Elle doit commencer par : feature/, fix/, refactor/ ou test/"
  exit 1
fi

echo "🔍 Lancement du lint..."
npm run lint
